# Minimal ignore list — only what this repo actually produces locally.
# When you add secrets, tooling, or generated folders, add a line here (see .cursor/rules/gitignore-hygiene.mdc).

# Xcode user state
*.xcuserstate
xcuserdata/

# Build outputs (Xcode + Swift Package Manager)
build/
DerivedData/
.build/

# macOS
.DS_Store
**/.DS_Store

# Local app secrets
Config/LocalSecrets.xcconfig

# Cursor AI (local workflow only)
.cursor/
*.cursorrules
